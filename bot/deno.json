{
  "tasks": {
    "run": "deno run -A --unstable-kv --env-file=.env main.ts",
    "build:linux": "deno compile -A --unstable-kv --output ./dist/wodvault-bot-linux main.ts",
    "build:windows": "deno compile -A --unstable-kv --target x86_64-pc-windows-msvc --output ./dist/wodvault-bot-windows.exe main.ts",
    "build:executables": "deno task build:linux && deno task build:windows"
  },
  "imports": {
    "harmony": "jsr:@harmony/harmony@^2.9.1",
    "@std/log": "jsr:@std/log@^0.224.14",
    "@std/fmt": "jsr:@std/fmt@^1.0.10",
    "@std/encoding": "jsr:@std/encoding@^1.0.11"
  }
}
