{
  "name": "wodvault",
  "main": "worker/dist/main.min.js",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./artifact",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHARACTER_EVENTS",
        "class_name": "CharacterEvents",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CharacterEvents"],
    },
  ],
  "kv_namespaces": [
    {
      "binding": "STORAGE",
      "id": "89873337436b479bbae32a2c36e74bfb",
    },
  ],
  "secrets": {
    "required": ["IMGBB_API_KEY"],
  },
  "observability": {
    "enabled": true,
  },
}
