{
  "name": "wodvault",
  "main": "worker/main.ts",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./artifact",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
}
